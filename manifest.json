      "bundled": false,
      "default": false
    }
  ],
  "disk_required_mb": 1300,
  "ram_required_mb": 2048,
  "config_schema": {
    "fields": [
      {
        "key": "threads",
        "type": "int",
        "label": "CPU threads",
        "default": 0,
        "min": 0,
        "max": 64,
        "step": 1,
        "help": "0 uses the number of logical processors, at most 8. More is rarely faster."
      },
      {
        "key": "voice_ref_audio",
        "type": "file",
        "label": "Fallback reference clip",
        "help": "Cloned by the speaker's own voice when Subtitld has no clip of the speaker to send: 5 to 20 seconds of one person speaking, clean and not a phone recording."
      }
    ]
  }
