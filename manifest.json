{
  "manifest_version": 1,
  "id": "zonos3",
  "version": "26.11.3",
  "display_name": "ZONOS3-Mini (offline, voice clone, 43 languages)",
  "summary": "Zyphra's ZONOS3-Mini speaks 43 languages at 44.1 kHz, in 27 stock voices or in the speaker's own voice, cloned from a few seconds of the video. Runs on the CPU, about twice as fast as real time, and checks each line as it speaks it so it doesn't skip words or run on after the text. The 1,115 MB model downloads on the first line; cloning needs 45 MB more.",
  "author": "Subtitld",
  "homepage": "https://github.com/Subtitld/addon-zonos3",
  "license": "Apache-2.0 (add-on; ZONOS3-Mini weights and default voices); MIT (ZONOS3-Mini runtime, ggml, nlohmann/json); MIT, Apache-2.0 and Unicode-3.0 (zyphra-textnorm); OpenLDAP (LMDB); BSD-3-Clause (pocketfft)",
  "executable": "bin/zonos3-addon",
  "protocol": 1,
  "startup_timeout_sec": 30,
  "platforms": [
    "linux",
    "macos",
    "windows",
    "haiku"
  ],
  "haiku_packages": [
    "python3.14"
  ],
  "tasks": [
    "tts.synthesize"
  ],
  "compute": "cpu",
  "voice_clone": true,
